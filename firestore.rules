rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Classroom game rooms
    match /rooms/{pin} {
      allow read, write: if pin.size() > 0 && pin.size() <= 32;

      // Participating students or teams in the room
      match /players/{playerId} {
        // For list and get: do not check playerId on list queries
        allow read: if pin.size() > 0 && pin.size() <= 32;
        allow write: if pin.size() > 0 && pin.size() <= 32 && playerId.size() > 0 && playerId.size() <= 64;
      }
    }
  }
}
